ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=cpu_adam -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -I/mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/deepspeed/ops/csrc/includes -isystem /mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/torch/include -isystem /mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/torch/include/TH -isystem /mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/torch/include/THC -isystem /usr/local/cuda/include -isystem /mnt/workspace/hwzhang/miniconda3/envs/dav3/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17 -O3 -std=c++17 -g -Wno-reorder -L/usr/local/cuda/lib64 -lcudart -lcublas -g -march=native -fopenmp -D__AVX512__ -D__ENABLE_CUDA__ -UC10_USE_GLOG -DBF16_AVAILABLE
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=cpu_adam -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -I/mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/deepspeed/ops/csrc/includes -isystem /mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/torch/include -isystem /mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/torch/include/TH -isystem /mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/torch/include/THC -isystem /usr/local/cuda/include -isystem /mnt/workspace/hwzhang/miniconda3/envs/dav3/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_90,code=compute_90 -gencode=arch=compute_90,code=sm_90 --compiler-options '-fPIC' -O3 --use_fast_math -std=c++20 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_HALF2_OPERATORS__ --threads=8 -gencode=arch=compute_90,code=sm_90 -gencode=arch=compute_90,code=compute_90 -UC10_USE_GLOG -DBF16_AVAILABLE -U__CUDA_NO_BFLOAT16_OPERATORS__ -U__CUDA_NO_BFLOAT162_OPERATORS__ -U__CUDA_NO_BFLOAT16_CONVERSIONS__
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -lcurand -L/usr/local/cuda/lib64 -L/mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build cpu_adam.o: compile /mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/deepspeed/ops/csrc/adam/cpu_adam.cpp
build cpu_adam_impl.o: compile /mnt/workspace/hwzhang/miniconda3/envs/dav3/lib/python3.10/site-packages/deepspeed/ops/csrc/adam/cpu_adam_impl.cpp



build cpu_adam.so: link cpu_adam.o cpu_adam_impl.o

default cpu_adam.so
